{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      }
    }
  },
  "channels": {
    "wecom": {
      "enabled": true,
      "connectionMode": "websocket",
      "botId": "${WECOM_BOT_ID}",
      "secret": "${WECOM_BOT_SECRET}",
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    }
  },
  "tools": {
    "profile": "messaging",
    "alsoAllow": [
      "erp_bind_start",
      "erp_binding_status",
      "erp_unbind",
      "erp_stock_query",
      "erp_material_search",
      "erp_partner_search",
      "erp_bill_search",
      "erp_bill_detail",
      "erp_report_query"
    ]
  },
  "plugins": {
    "entries": {
      "deepseek": { "enabled": true },
      "wecom-openclaw-plugin": { "enabled": true },
      "aierp-erp-tools": { "enabled": true }
    }
  }
}
