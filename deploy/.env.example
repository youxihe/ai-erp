# Copy to deploy/.env for local use. Never commit real secrets.
# Dedicated AI-ERP namespace — do not reuse HR/other project credentials.

AIERP_MYSQL_ROOT_PASSWORD=aierp_root_change_me
AIERP_MYSQL_USER=aierp
AIERP_MYSQL_PASSWORD=aierp_change_me
AIERP_MYSQL_HOST=127.0.0.1
AIERP_MYSQL_PORT=13306
AIERP_MYSQL_DATABASE=jsh_erp

AIERP_REDIS_HOST=127.0.0.1
AIERP_REDIS_PORT=16379
AIERP_REDIS_PASSWORD=aierp_redis_change_me

# Backend listen port (host)
AIERP_BOOT_PORT=9999

# Frontend (vue-cli) listen port
AIERP_WEB_PORT=3000
