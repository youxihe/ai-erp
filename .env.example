# AI-ERP local runtime placeholders (see also deploy/.env.example).
# Copy values into your local shell or deploy/.env; do not commit secrets.

AIERP_MYSQL_HOST=127.0.0.1
AIERP_MYSQL_PORT=13306
AIERP_MYSQL_DATABASE=jsh_erp
AIERP_MYSQL_USER=root
AIERP_MYSQL_PASSWORD=aierp_root_change_me

AIERP_REDIS_HOST=127.0.0.1
AIERP_REDIS_PORT=16379
AIERP_REDIS_PASSWORD=aierp_redis_change_me

AIERP_BOOT_PORT=9999
AIERP_WEB_PORT=3000

# Native jshERP demo accounts after SQL import (default seed, not production):
# tenant login: jsh / 123456
# admin login:  admin / 123456
