{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      }
    }
  },
  "channels": {
    "wecom": {
      "enabled": true,
      "connectionMode": "websocket",
      "botId": "${WECOM_BOT_ID}",
      "secret": "${WECOM_BOT_SECRET}",
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    }
  },
  "tools": {
    "profile": "messaging"
  }
}
